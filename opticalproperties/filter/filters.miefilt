name,table_csv,ref_thickness_mm,reference
schott_kg3,schott_kg3.mietab,3.0,"Schott KG3 heat-absorbing glass, internal transmittance datasheet republished by UQG (Optics) Ltd, 'KG3' data sheet (status 15.02.2016), reference thickness d=2mm; real vendor tabulated values (200-1100nm portion used here) scaled from 2mm to the 3.0mm ref_thickness_mm declared here via Beer's law tau(d2)=tau(d1)^(d2/d1) -- www.uqgoptics.com/wp-content/uploads/2019/08/Schott-KG3.pdf"
bp_550_40,bp_550_40.mietab,3.5,"modeled on Thorlabs FB550-40 soft-coated bandpass filter (CWL=550+-8nm, FWHM=40+-8nm, peak transmission ~70%, blocking <0.01% i.e. OD>4 from 200-1150nm per product page); curve is a Gaussian-profile engineering approximation of the passband anchored to the stated peak T and FWHM (vendor's interactive curve graph not machine-fetchable), floored at the datasheet's stated <=1e-4 blocking transmission; ref_thickness_mm=3.5 is a typical unmounted soft-coated 1in filter substrate thickness (exact figure not confirmed on the product page) -- www.thorlabs.com/thorproduct.cfm?partnumber=FB550-40"
longpass_600,longpass_600.mietab,2.0,"modeled on Thorlabs colored-glass longpass filters bracketing 600nm: no FGL600 (600nm) part actually exists in the current Thorlabs catalog -- nearest real parts are FGL590 (Schott OG590 glass, 590nm cut-on) and FGL610 (Schott RG610 glass, 610nm cut-on), both Ø25mm x 2mm colored glass; this row's 600nm cut-on is interpolated between those two real parts using a standard colored-glass sigmoid longpass transmission shape (passband internal T~0.99, stopband floor 1e-5), not a pixel digitization of either datasheet -- www.thorlabs.com/thorproduct.cfm?partnumber=FGL590 ; www.thorlabs.com/thorproduct.cfm?partnumber=FGL610"
nd_od01,nd_od01.mietab,2.0,"generated by scripts/tools/gen_registry_rows.py: illustrative absorptive Schott-NG-style neutral density filter, flat internal transmittance 400-1100nm, T=10^-OD=0.794328 at OD0.1, ref_thickness_mm=2.0 (catalog ND step); Beer-Lambert thickness scaling per optprops.py's load_filters(); not a digitized vendor curve"
nd_od02,nd_od02.mietab,2.0,"generated by scripts/tools/gen_registry_rows.py: illustrative absorptive Schott-NG-style neutral density filter, flat internal transmittance 400-1100nm, T=10^-OD=0.630957 at OD0.2, ref_thickness_mm=2.0 (catalog ND step); Beer-Lambert thickness scaling per optprops.py's load_filters(); not a digitized vendor curve"
nd_od03,nd_od03.mietab,2.0,"generated by scripts/tools/gen_registry_rows.py: illustrative absorptive Schott-NG-style neutral density filter, flat internal transmittance 400-1100nm, T=10^-OD=0.501187 at OD0.3, ref_thickness_mm=2.0 (catalog ND step); Beer-Lambert thickness scaling per optprops.py's load_filters(); not a digitized vendor curve"
nd_od04,nd_od04.mietab,2.0,"generated by scripts/tools/gen_registry_rows.py: illustrative absorptive Schott-NG-style neutral density filter, flat internal transmittance 400-1100nm, T=10^-OD=0.398107 at OD0.4, ref_thickness_mm=2.0 (catalog ND step); Beer-Lambert thickness scaling per optprops.py's load_filters(); not a digitized vendor curve"
nd_od05,nd_od05.mietab,2.0,"generated by scripts/tools/gen_registry_rows.py: illustrative absorptive Schott-NG-style neutral density filter, flat internal transmittance 400-1100nm, T=10^-OD=0.316228 at OD0.5, ref_thickness_mm=2.0 (catalog ND step); Beer-Lambert thickness scaling per optprops.py's load_filters(); not a digitized vendor curve"
nd_od06,nd_od06.mietab,2.0,"generated by scripts/tools/gen_registry_rows.py: illustrative absorptive Schott-NG-style neutral density filter, flat internal transmittance 400-1100nm, T=10^-OD=0.251189 at OD0.6, ref_thickness_mm=2.0 (catalog ND step); Beer-Lambert thickness scaling per optprops.py's load_filters(); not a digitized vendor curve"
nd_od10,nd_od10.mietab,2.0,"generated by scripts/tools/gen_registry_rows.py: illustrative absorptive Schott-NG-style neutral density filter, flat internal transmittance 400-1100nm, T=10^-OD=0.1 at OD1.0, ref_thickness_mm=2.0 (catalog ND step); Beer-Lambert thickness scaling per optprops.py's load_filters(); not a digitized vendor curve"
nd_od13,nd_od13.mietab,2.0,"generated by scripts/tools/gen_registry_rows.py: illustrative absorptive Schott-NG-style neutral density filter, flat internal transmittance 400-1100nm, T=10^-OD=0.0501187 at OD1.3, ref_thickness_mm=2.0 (catalog ND step); Beer-Lambert thickness scaling per optprops.py's load_filters(); not a digitized vendor curve"
nd_od20,nd_od20.mietab,2.0,"generated by scripts/tools/gen_registry_rows.py: illustrative absorptive Schott-NG-style neutral density filter, flat internal transmittance 400-1100nm, T=10^-OD=0.01 at OD2.0, ref_thickness_mm=2.0 (catalog ND step); Beer-Lambert thickness scaling per optprops.py's load_filters(); not a digitized vendor curve"
nd_od30,nd_od30.mietab,2.0,"generated by scripts/tools/gen_registry_rows.py: illustrative absorptive Schott-NG-style neutral density filter, flat internal transmittance 400-1100nm, T=10^-OD=0.001 at OD3.0, ref_thickness_mm=2.0 (catalog ND step); Beer-Lambert thickness scaling per optprops.py's load_filters(); not a digitized vendor curve"
nd_od40,nd_od40.mietab,2.0,"generated by scripts/tools/gen_registry_rows.py: illustrative absorptive Schott-NG-style neutral density filter, flat internal transmittance 400-1100nm, T=10^-OD=0.0001 at OD4.0, ref_thickness_mm=2.0 (catalog ND step); Beer-Lambert thickness scaling per optprops.py's load_filters(); not a digitized vendor curve"
shortpass_600,shortpass_600.mietab,2.0,"generated by scripts/tools/gen_registry_rows.py: exact mirror of longpass_600 about 600nm (T_shortpass(lambda) = T_longpass(1200-lambda)), domain clipped to >=400nm; same underlying colored-glass sigmoid edge approximation as longpass_600 (see that row's reference for the FGL590/FGL610 basis it was interpolated between), reflected to produce a shortpass cut-off at 600nm; illustrative, not a vendor part"
notch_633_25,notch_633_25.mietab,2.0,"generated by scripts/tools/gen_registry_rows.py: synthetic OD4 (T=1e-4) notch/rejection filter centered at 633nm (e.g. HeNe-line blocking), 25nm-FWHM Gaussian blocking band T(x)=Tout-(Tout-Tfloor)*exp(-4*ln2*(x/FWHM)^2) -- the same Gaussian-FWHM parametrization bp_550_40 uses for its passband, here inverted into a notch -- T~0.9 outside the notch; illustrative, not tied to a specific vendor part"
