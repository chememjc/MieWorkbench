tio2,oxide,tabulated,,,,,,,tio2.mienk,4230,0.38,1.1,"rutile ordinary ray from Devore formula n^2=5.913+0.2441/(lam_um^2-0.0803); formula's stated valid range is 0.43-1.53um so 380-430nm is a mild extrapolation (noted); k=0 assumed across visible/NIR (rutile absorption edge ~410nm not modeled); verified n(589nm)=2.613 vs target 2.61","DeVore 1951, J. Opt. Soc. Am. 41, 416 (ordinary ray dispersion formula); tabulated with k=0 for ray tracer use"
aluminum,metal,tabulated,,,,,,,aluminum.mienk,2700,,,"tabulated n,k 207-1240nm from Rakic 1995 experimental data (shows the real interband-transition feature near 800nm, e.g. n peaks ~2.8 at 775nm); k rises monotonically into the IR","Rakic 1995, Appl. Opt. 34, 4755 (evaporated Al films); data via refractiveindex.info"
gold,metal,tabulated,,,,,,,gold.mienk,19300,,,"tabulated n,k 368-1088nm; classic noble-metal optical constants used for plasmonic/mirror coatings","Johnson & Christy 1972, Phys. Rev. B 6, 4370; data via refractiveindex.info"
silver,metal,tabulated,,,,,,,silver.mienk,10490,,,"tabulated n,k 368-1088nm","Johnson & Christy 1972, Phys. Rev. B 6, 4370; data via refractiveindex.info"
mgf2,oxide,sellmeier,0.48755108,0.39875031,2.3120353,0.001882178,0.008951888,566.13559,,3180,0.2,7.0,"ordinary ray, uniaxial crystal; technically a fluoride not an oxide -- grouped under 'oxide' class for taxonomy simplicity (no dedicated fluoride class in schema); verified n(589nm)=1.377717 (sodium D; earlier note mislabelled this wavelength as 550nm)","Dodge 1984, Appl. Opt. 23, 1980 (ordinary ray); coefficients cross-checked on refractiveindex.info"
sio2_film,film,constant,1.46,0.0,,,,,,2200,0.25,2.0,"generic thin-film silica (e.g. evaporated or PECVD SiO2) used for AR coating layers; not a specific process recipe","Typical thin-film SiO2 index ~1.46 at 550nm (standard value, e.g. Macleod, 'Thin-Film Optical Filters')"
detector,special,constant,1.0,0.0,,,,,,0,,,"sentinel material for detector/absorber faces in the ray tracer; loader must accept it, n_complex returns 1+0j","Sentinel row (not a physical material); n=1 k=0 placeholder so detector faces do not refract/absorb via Fresnel terms"
calcite_o,oxide,sellmeier,0.96464345,1.82831454,0.73358749,0.0194325203,120,1e-08,,2710,0.204,2.172,"ordinary ray, uniaxial crystal; Ghosh's native 2-term form (n^2-1=A+B1*lam^2/(lam^2-C1)+B2*lam^2/(lam^2-C2)) mapped into this schema's 3-term Sellmeier via B3=A,C3=1e-8 um^2 (loader requires Ci>0 so a true C3=0 identity is not allowed; lam^2/(lam^2-1e-8)~=1 to <1e-7 relative error over lam=0.2-2um, i.e. numerically exact); technically a carbonate not an oxide -- grouped under 'oxide' class for taxonomy simplicity (no dedicated carbonate class in schema, same precedent as mgf2 fluoride row); verified n(590nm)=1.65830 vs target 1.658","Ghosh 1999, Opt. Commun. 163, 95-102 (dispersion-equation coefficients for calcite and quartz); coefficients per refractiveindex.info (shelf=main, book=CaCO3, page=Ghosh-o)"
calcite_e,oxide,sellmeier,0.82427830,0.14429128,0.35859695,0.0106689543,120,1e-08,,2710,0.204,2.172,"extraordinary ray, uniaxial crystal (negative uniaxial: n_e<n_o, pairs with calcite_o above); same exact Ghosh-2-term-to-3-term mapping as calcite_o (B3=A,C3=1e-8 um^2, see calcite_o note); grouped under 'oxide' class for taxonomy simplicity per mgf2 precedent; verified n(590nm)=1.48611 vs target 1.486","Ghosh 1999, Opt. Commun. 163, 95-102; coefficients per refractiveindex.info (shelf=main, book=CaCO3, page=Ghosh-e)"
quartz_o,oxide,sellmeier,1.07044083,1.10202242,0.28604141,0.0100585997,100,1e-08,,2650,0.198,2.053,"ordinary ray, crystalline alpha-quartz (uniaxial; distinct from the amorphous fused_silica row already in this file); Ghosh 2-term form mapped into this schema's 3-term Sellmeier (B3=A,C3=1e-8 um^2 since loader requires Ci>0, see calcite_o note for error bound); verified n(589nm)=1.54422 vs target 1.5443","Ghosh 1999, Opt. Commun. 163, 95-102; coefficients per refractiveindex.info (shelf=main, book=SiO2, page=Ghosh-o)"
quartz_e,oxide,sellmeier,1.09509924,1.15662475,0.28851804,0.0102101864,100,1e-08,,2650,0.198,2.053,"extraordinary ray, crystalline alpha-quartz (positive uniaxial: n_e>n_o, pairs with quartz_o above); same exact Ghosh-2-term-to-3-term mapping as quartz_o; verified n(589nm)=1.55332 vs target 1.5534","Ghosh 1999, Opt. Commun. 163, 95-102; coefficients per refractiveindex.info (shelf=main, book=SiO2, page=Ghosh-e)"
sapphire_e,oxide,sellmeier,1.5039759,0.55069141,6.5927379,0.0054802632,0.0147994281,402.8951398,,3980,0.2,5.0,"extraordinary ray (uniaxial crystal, pairs with sapphire_o above); C values are squares of refractiveindex.info's 0.0740288/0.1216529/20.072248 um; native 3-term Sellmeier form, no mapping needed; verified n(589nm)=1.76002 vs target ~1.760","Malitson & Dodge 1972 (I.H. Malitson and M.J. Dodge, unpublished, as tabulated by refractiveindex.info); coefficients per refractiveindex.info (shelf=main, book=Al2O3, page=Malitson-e)"
